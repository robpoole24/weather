# ╔══════════════════════════════════════════════════════════════╗
# ║         ↓↓↓  PASTE YOUR API KEY RIGHT HERE  ↓↓↓            ║
# ║  No quotes needed — just paste after the equals sign        ║
# ║  Example: YOUTUBE_API_KEY=AIzaSyABC123xyz...               ║
# ╚══════════════════════════════════════════════════════════════╝
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY
# ▲▲▲ ONLY LINE YOU NEED TO EDIT LOCALLY ▲▲▲

PORT=3000

# ── Set these when deployed to Railway ──
# APP_URL is your Railway public URL (e.g. https://weather-tv.up.railway.app)
# This enables WebSub push notifications from YouTube — zero quota cost for live detection
# Leave blank on localhost — polling fallback is used automatically
APP_URL=

# A secret string used to verify WebSub notifications are from YouTube
# Can be any random string — change it to something unique
WEBSUB_SECRET=weathertv-websub-secret-change-me
